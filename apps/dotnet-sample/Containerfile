FROM registry.access.redhat.com/ubi9/dotnet-100 AS build
WORKDIR /src
COPY src/Customer.Sample.Api/Customer.Sample.Api.csproj src/Customer.Sample.Api/
RUN dotnet restore src/Customer.Sample.Api/Customer.Sample.Api.csproj
COPY src/Customer.Sample.Api/ src/Customer.Sample.Api/
RUN dotnet publish src/Customer.Sample.Api/Customer.Sample.Api.csproj \
    --configuration Release --no-restore --output /opt/app-root/app

FROM registry.access.redhat.com/ubi9/dotnet-100-runtime
WORKDIR /opt/app-root/app
COPY --from=build /opt/app-root/app .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
USER 1001
ENTRYPOINT ["dotnet", "Customer.Sample.Api.dll"]
