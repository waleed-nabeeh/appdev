<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="MofaNuget" value="https://azuredevops.mofa.gov.sa/MOFA/_packaging/MofaNuget%40Local/nuget/v3/index.json" />
    <add key="nuget.abp.io" value="https://nuget.abp.io/300ed1b6-e678-4bc7-873f-8c476f4cda4f/v3/index.json" />
  </packageSources>
  <config>
    <add key="maxHttpRequestsPerSource" value="4" />
  </config>
  <packageSourceMapping>
    <clear />
    <packageSource key="MofaNuget">
      <package pattern="*" />
      <package pattern="Volo.*" />
    </packageSource>
    <packageSource key="nuget.abp.io">
      <package pattern="Volo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
